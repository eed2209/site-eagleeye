---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';

const photos = Array.from({ length: 18 }, (_, i) => 'id-' + String(i + 1).padStart(2, '0'));
const img = (p) => `/images/id3/${p}.jpg`;

// Cylindre 3D : 10 photos reparties sur l'anneau
const ring = photos.slice(0, 10).map((p, i) => ({ p, a: i * 36 }));
const ringRadius = 360;
---
<Base title="Démo carrousels — Indépendance Day" description="Page de démonstration interne.">
  <Fragment slot="head">
    <meta name="robots" content="noindex, nofollow" />
  </Fragment>
  <Header />
  <main class="page">
    <span class="eyebrow">Démo interne</span>
    <h1>4 styles de défilement</h1>
    <p class="lede">Comparez les 4 styles ci-dessous avec les photos de l'Indépendance Day, puis dites-moi lequel vous préférez (ou un mélange). Je l'appliquerai sur la vraie page.</p>

    <!-- ============ STYLE 1 : Bande inclinée (2 rangées opposées) ============ -->
    <section>
      <h2>1. Bande inclinée (2 rangées opposées)</h2>
      <div class="d1">
        <div class="d1-row">
          <div class="d1-track d1-left">
            {photos.concat(photos).map((p) => <img src={img(p)} alt="Indépendance Day" loading="lazy" />)}
          </div>
        </div>
        <div class="d1-row">
          <div class="d1-track d1-right">
            {photos.slice().reverse().concat(photos.slice().reverse()).map((p) => <img src={img(p)} alt="Indépendance Day" loading="lazy" />)}
          </div>
        </div>
      </div>
    </section>

    <!-- ============ STYLE 2 : Carrousel 3D cylindre ============ -->
    <section>
      <h2>2. Carrousel 3D (cylindre rotatif)</h2>
      <div class="d2-stage">
        <div class="d2-ring">
          {ring.map((r) => (
            <div class="d2-cell" style={`transform:rotateY(${r.a}deg) translateZ(${ringRadius}px)`}>
              <img src={img(r.p)} alt="Indépendance Day" loading="lazy" />
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ============ STYLE 3 : Focus central (coverflow) ============ -->
    <section>
      <h2>3. Focus central (la photo du milieu grossit)</h2>
      <div class="d3" id="d3">
        {photos.map((p) => <figure class="d3-item"><img src={img(p)} alt="Indépendance Day" loading="lazy" /></figure>)}
      </div>
    </section>

    <!-- ============ STYLE 4 : Mur vertical (colonnes alternées) ============ -->
    <section>
      <h2>4. Mur vertical (colonnes alternées)</h2>
      <div class="d4">
        <div class="d4-col d4-up">{photos.slice(0, 6).concat(photos.slice(0, 6)).map((p) => <img src={img(p)} alt="Indépendance Day" loading="lazy" />)}</div>
        <div class="d4-col d4-down">{photos.slice(6, 12).concat(photos.slice(6, 12)).map((p) => <img src={img(p)} alt="Indépendance Day" loading="lazy" />)}</div>
        <div class="d4-col d4-up">{photos.slice(12, 18).concat(photos.slice(12, 18)).map((p) => <img src={img(p)} alt="Indépendance Day" loading="lazy" />)}</div>
      </div>
    </section>

    <p class="lede" style="margin-top:40px">Dites-moi le numéro qui vous plaît (1, 2, 3 ou 4), et si vous voulez des réglages (vitesse, taille, inclinaison…).</p>
  </main>
</Base>

<style>
  /* ---- Style 1 : bande inclinée ---- */
  .d1{overflow:hidden;padding:26px 0;transform:rotate(-5deg) scale(1.08);transform-origin:center}
  .d1-row{overflow:hidden;margin:7px 0;
    -webkit-mask-image:linear-gradient(90deg,transparent,#000 8%,#000 92%,transparent);
    mask-image:linear-gradient(90deg,transparent,#000 8%,#000 92%,transparent)}
  .d1-track{display:flex;gap:12px;width:max-content}
  .d1-track img{height:150px;width:auto;border-radius:10px;display:block;box-shadow:var(--shadow)}
  .d1-left{animation:d1scroll 60s linear infinite}
  .d1-right{animation:d1scroll 60s linear infinite reverse}
  @keyframes d1scroll{from{transform:translateX(0)}to{transform:translateX(-50%)}}

  /* ---- Style 2 : cylindre 3D ---- */
  .d2-stage{height:300px;perspective:1100px;overflow:hidden}
  .d2-ring{position:relative;width:260px;height:180px;margin:60px auto 0;transform-style:preserve-3d;animation:d2spin 34s linear infinite}
  .d2-ring:hover{animation-play-state:paused}
  .d2-cell{position:absolute;inset:0;backface-visibility:hidden}
  .d2-cell img{width:260px;height:180px;object-fit:cover;border-radius:10px;box-shadow:var(--shadow)}
  @keyframes d2spin{from{transform:rotateY(0)}to{transform:rotateY(360deg)}}

  /* ---- Style 3 : focus central ---- */
  .d3{display:flex;gap:18px;overflow-x:auto;scroll-snap-type:x mandatory;padding:60px 46%;scrollbar-width:none}
  .d3::-webkit-scrollbar{display:none}
  .d3-item{flex:0 0 auto;margin:0;scroll-snap-align:center;transition:transform .35s ease,opacity .35s ease;opacity:.55;transform:scale(.7)}
  .d3-item img{width:320px;height:214px;object-fit:cover;border-radius:12px;display:block;box-shadow:var(--shadow)}
  .d3-item.is-active{opacity:1;transform:scale(1)}

  /* ---- Style 4 : mur vertical ---- */
  .d4{display:grid;grid-template-columns:repeat(3,1fr);gap:14px;height:460px;overflow:hidden;
    -webkit-mask-image:linear-gradient(#000 0,#000 100%);mask-image:linear-gradient(transparent,#000 10%,#000 90%,transparent)}
  .d4-col{display:flex;flex-direction:column;gap:14px}
  .d4-col img{width:100%;height:220px;object-fit:cover;border-radius:12px;box-shadow:var(--shadow)}
  .d4-up{animation:d4up 40s linear infinite}
  .d4-down{animation:d4down 40s linear infinite}
  @keyframes d4up{from{transform:translateY(0)}to{transform:translateY(-50%)}}
  @keyframes d4down{from{transform:translateY(-50%)}to{transform:translateY(0)}}

  @media (max-width:640px){
    .d4{grid-template-columns:repeat(2,1fr)}
    .d3{padding:60px 38%}
  }
</style>

<script>
  // Style 3 : marque la photo la plus centrée comme active + auto-défilement
  (function () {
    const track = document.getElementById('d3');
    if (!track) return;
    const items = Array.from(track.querySelectorAll('.d3-item'));
    function update() {
      const c = track.scrollLeft + track.clientWidth / 2;
      let best = null, bestDist = Infinity;
      items.forEach((it) => {
        const mid = it.offsetLeft + it.offsetWidth / 2;
        const d = Math.abs(mid - c);
        if (d < bestDist) { bestDist = d; best = it; }
      });
      items.forEach((it) => it.classList.toggle('is-active', it === best));
    }
    track.addEventListener('scroll', () => { window.requestAnimationFrame(update); }, { passive: true });
    update();
    // auto-avance
    let idx = 0, paused = false;
    track.addEventListener('pointerenter', () => { paused = true; });
    track.addEventListener('pointerleave', () => { paused = false; });
    setInterval(() => {
      if (paused) return;
      idx = (idx + 1) % items.length;
      const it = items[idx];
      track.scrollTo({ left: it.offsetLeft + it.offsetWidth / 2 - track.clientWidth / 2, behavior: 'smooth' });
    }, 2200);
  })();
</script>
