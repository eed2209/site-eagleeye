---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';

/* Témoignages clients des programmes EED, hébergés sur le Viméo de Nassim.
   Lecture au clic via le player Viméo en mode sans pistage (dnt=1) : aucun
   cookie tant que la vidéo n'est pas lancée, aucun cookie de suivi ensuite.
   h = code d'accès des vidéos non répertoriées (vide si vidéo publique). */
const temoignages = [
  { id: '1174799252', h: 'f763e4c002', name: 'Robson Richers',    portrait: false, thumb: '2135468752-611f685af2c4a3ea842cc146ede1c170c099e420ae292093a380c64a13ab10e8-d' },
  { id: '1097519133', h: 'f1ddad3479', name: 'Barbara Vincent',   portrait: false, thumb: '2031891123-922dab21198e1d9da977739130dd0afe403026717fecae3d8f7c83dcdce57211-d' },
  { id: '765655770',  h: '',           name: 'David Beck',        portrait: false, thumb: '1537552906-54c7ea86b4723309cdddd7a0e3d35330118f85fa347f24d91d6a8d89562cfb69-d' },
  { id: '1174799841', h: 'ed399967e4', name: 'Olivier Chaudron',  portrait: false, thumb: '2135472885-ade6e3780adc1ff5086ab5d6da51e18a987d3d9a7265b5bd38b94d7c6087fdf0-d' },
  { id: '1175539799', h: 'be9d2d7ae8', name: 'Patricia Foillard', portrait: false, thumb: '2136400741-35bc4d15a60789a5a666044b63fd16d7489d170aec847d2912f5a3b10baa78b4-d' },
  { id: '765721516',  h: '',           name: 'Philippe Griffol',  portrait: true,  thumb: '1537669637-5cadc02b4e509ae9d2b8a5c4918e0cd87d6c6f4a423049a5b744d051f94ccd18-d' },
  { id: '1073908146', h: 'fe6dbe82c8', name: 'Florence Tosi',     portrait: true,  thumb: '2003151290-5de3a83cf496e92273060992e408007d35281287894eccf92a41269a84e8a460-d' },
  { id: '1097531379', h: 'ab3645ce11', name: 'Corinne Carlier',   portrait: true,  thumb: '2031902986-abfabdacc4f8181d749c7b88c28e296d58684987cbe9013251c8e87f94a1d095-d' },
  { id: '1174799131', h: '5974830dcb', name: 'Stéphanie Moillic', portrait: true,  thumb: '2135467946-1e5ad59ee3f505e8a4b86af049ab12b4be97d791b531363701a7d245e02f62be-d' },
  { id: '1174799090', h: 'fe66f5c6a0', name: 'Gwladys Cren',      portrait: true,  thumb: '2135467757-6ac0aacc33658d9a1261334bb6b96e95a0c020d5c5fe5afa9a65b0789739eb90-d' },
];
const paysage = temoignages.filter(t => !t.portrait);
const portrait = temoignages.filter(t => t.portrait);
const thumbUrl = (t) => `https://i.vimeocdn.com/video/${t.thumb}_640`;
---
<Base
  title="Témoignages clients : ils ont confié leur LinkedIn à Eagle Eye Digital"
  description="Consultants, dirigeants de TPE, formateurs : leurs témoignages en vidéo après avoir suivi les programmes Eagle Eye Digital."
>
  <Header />
  <main class="page">
    <span class="eyebrow">Témoignages</span>
    <h1>Ils ont confié leur LinkedIn à Eagle Eye Digital.</h1>
    <p class="lede">Des indépendants et des dirigeants de TPE, en vidéo et dans leurs mots.</p>

    <section>
      <div class="video-temos">
        {paysage.map(t => (
          <figure class="vt-card">
            <button class="video-temo" type="button" data-vimeo-id={t.id} data-vimeo-h={t.h} style={`background-image:url('${thumbUrl(t)}')`} aria-label={`Lire le témoignage de ${t.name}`}>
              <span class="vt-play" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M8 5.5v13l11-6.5z"/></svg></span>
            </button>
            <figcaption>{t.name}</figcaption>
          </figure>
        ))}
      </div>

      <div class="video-temos video-temos-portrait">
        {portrait.map(t => (
          <figure class="vt-card vt-portrait">
            <button class="video-temo" type="button" data-vimeo-id={t.id} data-vimeo-h={t.h} style={`background-image:url('${thumbUrl(t)}')`} aria-label={`Lire le témoignage de ${t.name}`}>
              <span class="vt-play" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M8 5.5v13l11-6.5z"/></svg></span>
            </button>
            <figcaption>{t.name}</figcaption>
          </figure>
        ))}
      </div>
    </section>

    <!-- Le programme que les personnes ci-dessus ont suivi : le LinkedIn
         Business Accelerator. Bloc repris aux couleurs du funnel
         masterclass.eagleeye.digital (bleu nuit, bleu vif, surligné jaune)
         pour le détacher visuellement du reste de la page. -->
    <section class="lba-bloc">
      <div class="lba-card">
        <span class="lba-kicker">Le programme qu'ils ont suivi</span>
        <h2>Tous passés par le <span class="lba-hl">LinkedIn&nbsp;Business&nbsp;Accelerator</span>.</h2>
        <p class="lba-lede">Nos témoins n'ont pas « fait du LinkedIn » tout seuls dans leur coin. Ils ont installé un système avec notre équipe : la méthode 3C+2, des actions mises en place pour eux dès le premier mois, puis un accompagnement qui tient sur la durée.</p>
        <ul class="lba-points">
          <li>Diagnostic &amp; roadmap, revue de profil, de posts et d'offre — mis en place par l'équipe</li>
          <li>Des résultats concrets et mesurables dès les 30 premiers jours</li>
          <li>Coaching collectif 3 fois par semaine et communauté privée</li>
          <li>Satisfait ou remboursé · finançable (organisme de formation Qualiopi)</li>
        </ul>
        <a class="lba-cta" href="/offres/accompagnement-prospection/">Découvrir le LinkedIn Business Accelerator →</a>
        <p class="lba-note">Une dizaine de places par mois. Sans engagement.</p>
      </div>
    </section>

    <section>
      <h2>Et vous, où en êtes-vous ?</h2>
      <p>Commencez comme eux : par le <a href="/diagnostic-linkedin/">diagnostic gratuit</a>.</p>
      <a class="btn" href="/#scanner">Faire mon diagnostic gratuit</a>
    </section>
  </main>

  <style>
    /* Bloc LBA aux couleurs du funnel masterclass (navy #0B1B33, bleu #1B6EF3,
       jaune #FFD400). Couleurs fixes, indépendantes du thème clair/sombre du
       site : c'est un panneau autonome, comme la section « événement ». */
    .lba-bloc{padding-top:46px}
    .lba-card{
      position:relative;overflow:hidden;
      background:linear-gradient(160deg,#122744 0%,#0B1B33 62%);
      border:1px solid rgba(27,110,243,.35);
      border-radius:24px;padding:52px 48px;
      box-shadow:0 30px 70px -30px rgba(0,0,0,.6);
      color:#EAF1FF;
    }
    .lba-card .lba-kicker{
      display:inline-block;font-size:.74rem;font-weight:700;letter-spacing:.16em;
      text-transform:uppercase;color:#FFD400;margin-bottom:16px;
    }
    .lba-card h2{
      font-size:clamp(1.6rem,3vw,2.2rem);font-weight:800;color:#fff;
      line-height:1.18;margin:0 0 18px;max-width:24ch;
    }
    .lba-hl{position:relative;display:inline-block;color:#0B1B33;z-index:0;padding:0 8px}
    .lba-hl::before{
      content:"";position:absolute;left:0;right:0;bottom:.06em;height:.46em;
      background:#FFD400;transform:skewX(-6deg);z-index:-1;border-radius:2px;
    }
    .lba-card .lba-lede{color:#B9C8DE;max-width:62ch;margin:0 0 24px;font-size:1.02rem;line-height:1.65}
    .lba-card .lba-points{list-style:none;margin:0 0 30px;padding:0;display:grid;gap:12px;max-width:64ch}
    .lba-card .lba-points li{position:relative;padding-left:30px;color:#DCE4F0;font-size:.96rem;margin:0}
    .lba-card .lba-points li::before{
      content:"✓";position:absolute;left:0;top:0;color:#FFD400;font-weight:800;font-size:1.05rem;
    }
    .lba-card .lba-cta{
      display:inline-block;text-decoration:none;
      background:linear-gradient(180deg,#1B6EF3 0%,#0F52C4 100%);
      color:#fff;font-weight:800;font-size:1.02rem;letter-spacing:.4px;
      padding:17px 34px;border-radius:12px;
      box-shadow:0 6px 0 #0A3F96, 0 12px 24px rgba(15,82,196,.35);
      transition:transform .12s ease,box-shadow .12s ease;
    }
    .lba-card .lba-cta:hover{transform:translateY(3px);box-shadow:0 3px 0 #0A3F96, 0 8px 18px rgba(15,82,196,.35)}
    .lba-card .lba-cta:active{transform:translateY(6px);box-shadow:0 0 0 #0A3F96}
    .lba-card .lba-cta:focus-visible{outline:3px solid #FFD400;outline-offset:3px}
    .lba-card .lba-note{margin:16px 0 0;color:#8A99AE;font-size:.84rem;max-width:none}
    @media (max-width:600px){
      .lba-card{padding:34px 24px;border-radius:18px}
      .lba-card .lba-cta{display:block;text-align:center}
    }
  </style>
</Base>
