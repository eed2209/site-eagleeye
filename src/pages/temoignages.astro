---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';

/* Témoignages clients des programmes EED, hébergés sur le Viméo de Nassim.
   Lecture au clic via le player Viméo en mode sans pistage (dnt=1) : aucun
   cookie tant que la vidéo n'est pas lancée, aucun cookie de suivi ensuite.
   h = code d'accès des vidéos non répertoriées (vide si vidéo publique).

   Toute la page est habillée aux couleurs du funnel masterclass.eagleeye.digital
   (bleu nuit #0B1B33, bleu vif #1B6EF3, surligné jaune #FFD400). Ces couleurs
   sont fixes et locales à la page (variables sous .mc-page) : elles ne dépendent
   pas du thème clair/sombre du site. L'en-tête et le pied de page restent ceux
   du site. */
const temoignages = [
  { id: '1174799252', h: 'f763e4c002', name: 'Robson Richers',    portrait: false, thumb: '2135468752-611f685af2c4a3ea842cc146ede1c170c099e420ae292093a380c64a13ab10e8-d' },
  { id: '1097519133', h: 'f1ddad3479', name: 'Barbara Vincent',   portrait: false, thumb: '2031891123-922dab21198e1d9da977739130dd0afe403026717fecae3d8f7c83dcdce57211-d' },
  { id: '765655770',  h: '',           name: 'David Beck',        portrait: false, thumb: '1537552906-54c7ea86b4723309cdddd7a0e3d35330118f85fa347f24d91d6a8d89562cfb69-d' },
  { id: '1174799841', h: 'ed399967e4', name: 'Olivier Chaudron',  portrait: false, thumb: '2135472885-ade6e3780adc1ff5086ab5d6da51e18a987d3d9a7265b5bd38b94d7c6087fdf0-d' },
  { id: '1175539799', h: 'be9d2d7ae8', name: 'Patricia Foillard', portrait: false, thumb: '2136400741-35bc4d15a60789a5a666044b63fd16d7489d170aec847d2912f5a3b10baa78b4-d' },
  { id: '765721516',  h: '',           name: 'Philippe Griffol',  portrait: true,  thumb: '1537669637-5cadc02b4e509ae9d2b8a5c4918e0cd87d6c6f4a423049a5b744d051f94ccd18-d' },
  { id: '1073908146', h: 'fe6dbe82c8', name: 'Florence Tosi',     portrait: true,  thumb: '2003151290-5de3a83cf496e92273060992e408007d35281287894eccf92a41269a84e8a460-d' },
  { id: '1097531379', h: 'ab3645ce11', name: 'Corinne Carlier',   portrait: true,  thumb: '2031902986-abfabdacc4f8181d749c7b88c28e296d58684987cbe9013251c8e87f94a1d095-d' },
  { id: '1174799131', h: '5974830dcb', name: 'Stéphanie Moillic', portrait: true,  thumb: '2135467946-1e5ad59ee3f505e8a4b86af049ab12b4be97d791b531363701a7d245e02f62be-d' },
  { id: '1174799090', h: 'fe66f5c6a0', name: 'Gwladys Cren',      portrait: true,  thumb: '2135467757-6ac0aacc33658d9a1261334bb6b96e95a0c020d5c5fe5afa9a65b0789739eb90-d' },
  { id: '1237549805', h: '34a33dc5df', name: 'Sonia Lagrost',     portrait: false, thumb: '2214361150-fdd071c77fd2f05123fda353ed5b09b65c9a6284ef765daaca9a76b1c6254fd9-d' },
  { id: '1221385557', h: 'bdbae183fa', name: 'Maya Caballero',    portrait: false, thumb: '2194073589-0a303620ea19f692f6e9d89803a0bca9e7c0af50443636cd94c45dfd1fc069dc-d' },
  { id: '1177255738', h: '7c20880665', name: 'Marc Bernard',      portrait: false, thumb: '2169198390-5d1189b36ba8fe3b9be0b24e6c3d6a11ad928144b73f4ef9cf6dad6e62130693-d' },
];
const paysage = temoignages.filter(t => !t.portrait);
const portrait = temoignages.filter(t => t.portrait);
const thumbUrl = (t) => `https://i.vimeocdn.com/video/${t.thumb}_640`;

/* Les 5 piliers de la méthode 3C+2, socle du LinkedIn Business Accelerator. */
const piliers = [
  { c: 'C', t: 'Clarté',      d: 'Une cible précise, une offre qui donne envie. Le pilier que presque tout le monde saute, et qui conditionne tous les autres.' },
  { c: 'C', t: 'Crédibilité', d: 'Un profil qui inspire confiance et du contenu qui montre l’expert, pas l’IA. Sans crédibilité, rien ne se passe.' },
  { c: 'C', t: 'Connexions',  d: 'Un réseau composé en majorité de profils de clients idéaux. On multiplie la probabilité que quelque chose se passe.' },
  { c: 'C', t: 'Conquête',    d: 'Faire le premier pas, au bon moment, avec le bon message — et savoir transformer les conversations en clients.' },
  { c: '2', t: 'Catalyse',    d: 'Les bons outils, les bons templates, l’IA en coulisses et un environnement qui vous garde en mouvement.' },
];

/* Avis Google clients (fiche Eagle Eye Digital, 4,8/5). Transcrits à la main
   depuis la fiche Google — tous en 5/5 sauf Bernard Quidarré (4/5). Dédoublonnés.
   Affichés tels quels ; le bouton renvoie vers la fiche pour l'intégralité. */
const avis = [
  { n: 'Anne Guillaume',     note: 5, t: "Le programme LinkedIn Business Accelerator est un outil précieux pour quiconque souhaite accroître sa visibilité et développer un réseau solide sur LinkedIn. Au-delà des modules très pratiques et des webinaires gratuits proposés sur divers sujets pertinents, la véritable valeur ajoutée de Nassim réside dans son engagement à vous accompagner à votre rythme, toujours avec respect et des conseils avisés. Merci." },
  { n: 'Pierre Petruzzelli', note: 5, t: "J'ai triplé ma visibilité sur LinkedIn grâce à un accompagnement précis, personnalisé et extrêmement efficace en seulement un mois. Les échanges avec l'équipe ont été très enrichissants ; les réponses à mes questions étaient précises et immédiatement applicables. Nassim et son équipe mettent tout en œuvre pour répondre à nos besoins et à nos attentes. Merci !" },
  { n: 'David Beck',         note: 5, t: "J'ai eu l'opportunité de participer au programme LinkedIn Sales Accelerator, qui offre de nombreuses clés pour optimiser ses opportunités et son temps. Je recommande vivement ce programme aux freelances comme moi, ou à toute personne en pleine croissance. Vous recherchez un professionnel compétent et attentif pour vous accompagner dans le développement de votre réseau et l'augmentation de votre chiffre d'affaires ? Ne cherchez plus ! Faites confiance à Eagle Eye Digital : vous ne le regretterez pas !" },
  { n: 'Cynthia Roulez',     note: 5, t: "J'ai rencontré Nassim lors d'un de ses webinaires et j'ai eu l'opportunité de bénéficier d'un coaching sur les avantages d'une présence active et régulière sur LinkedIn. J'ai pris note de ses conseils, astuces et encouragements, et je compte remédier à mon silence numérique au plus vite. Je recommande vivement Nassim à toute personne souhaitant développer sa présence sur LinkedIn et accroître sa visibilité." },
  { n: 'Laure Demerson',     note: 5, t: "J'ai intégré le programme LinkedIn Business Accelerator ! Cela me semblait être un excellent moyen de maîtriser LinkedIn comme canal d'acquisition de clients. Ce que j'apprécie particulièrement : la flexibilité des modules en ligne, qui me permet de progresser à mon rythme ; les séances de coaching de groupe qui favorisent les échanges et le partage d'expériences ; et l'opportunité de bénéficier de conseils d'experts." },
  { n: 'Christine Kraus',    note: 5, t: "Nassim Amisse a parfaitement cerné les besoins spécifiques de mon activité, un peu atypique, de courtier en chevaux. Grâce à l'accompagnement d'Eagle Eye Digital, j'ai pu optimiser ma communication sur LinkedIn. J'ai gagné du temps et, surtout, une visibilité accrue. Mais ce n'est pas tout : Nassim m'a prodigué de nombreux conseils pour développer mon profil, et mon réseau s'est considérablement agrandi. Un grand merci à Nassim et à son équipe formidable !" },
  { n: 'Emmanuel Hunter',    note: 5, t: "J'apprécie tout particulièrement le soutien et le coaching de Nassim pour développer mes compétences sur LinkedIn. Je partais de zéro et j'avais pas mal d'appréhensions, mais ses conseils m'ont permis de me lancer et m'ont donné envie d'explorer davantage ce système vaste et complexe, le tout dans une approche humaine et sans pression commerciale. Merci, Nassim." },
  { n: 'Aurélie Malochet',   note: 5, t: "J'ai rencontré Nassim sur LinkedIn et j'ai eu le plaisir d'assister à quelques webinaires. Après plusieurs échanges, j'ai bénéficié d'un accompagnement en prospection, notamment sur LinkedIn. Eagle Eye Digital a mis en place une solution pour optimiser ma prospection, ce qui a permis d'élargir considérablement mon réseau et d'accroître mon nombre de contacts et d'abonnés. Leur équipe est très sympathique, disponible et accueillante." },
  { n: 'Stéphanie Scrocco',  note: 5, t: "En tant que coach en orientation professionnelle et transition de carrière, j'ai intégré le programme LinkedIn Sales Accelerator et j'en suis extrêmement satisfaite. Les modules sont exceptionnellement bien conçus et complets. J'ai pu affiner ma stratégie de contenu et découvrir de nouveaux outils et méthodes de prospection. Je recommande vivement ce programme très pratique, riche en conseils et ressources. De plus, l'équipe est fantastique !" },
  { n: 'Alex Rouillard',     note: 5, t: "En tant que conseillère en gestion de patrimoine, j'ai eu l'opportunité de tester le programme LinkedIn Sales Accelerator et j'en suis ravie. Les modules sont très clairs et complets, et surtout, ils conviennent à tous les niveaux de maîtrise de LinkedIn. J'ai optimisé ma présence en ligne et découvert de nouveaux outils et méthodes de prospection. Je recommande vivement ce programme résolument pratique, efficace et concret. L'équipe est très accessible et le temps passe vite lorsqu'on travaille avec elle !" },
  { n: 'Patricia Foillard',  note: 5, t: "J'ai eu le privilège de lire « La Méthode 3C » de Nassim Amisse, et je dois dire que ce livre est une véritable pépite. Il offre une perspective unique sur la manière de réussir sur LinkedIn, une plateforme souvent complexe à maîtriser. L'auteur a su condenser les meilleures pratiques dans un guide accessible, adapté aussi bien aux débutants qu'aux experts. Je recommande vivement ce livre, qui m'a offert une vision novatrice de LinkedIn." },
  { n: 'Céline Bouleau',     note: 5, t: "J'ai eu l'opportunité de faire la connaissance de Nassim en participant à l'un de ses webinaires, puis à d'autres ! Nous avons discuté à plusieurs reprises des services d'Eagle Eye Digital, et j'ai pu bénéficier d'un mois d'essai gratuit pour développer mon réseau LinkedIn et nouer des contacts prometteurs. Son équipe m'a apporté un soutien précieux. Tout le monde est accessible et sympathique ; c'est un vrai plaisir de travailler avec eux !" },
  { n: 'Alexandre Bébé',     note: 5, t: "L'équipe d'Eagle Eye Digital, et Nassim en particulier, m'a prodigué des conseils et des recommandations précieuses pour optimiser mes publications LinkedIn. Le résultat a été indéniable : de nombreuses réactions positives et, surtout, des demandes de devis inattendues. Un grand merci à Eagle Eye Digital !" },
  { n: 'Céline Di Venuto',   note: 5, t: "J'ai suivi les conseils de Nassim pour organiser mon webinaire sur le référencement Google et j'ai non seulement obtenu plus d'inscriptions que pour les webinaires précédents, mais aussi un plus grand nombre de participants. Beaucoup ont souhaité poursuivre la discussion, ce qui prouve que nous avons attiré le bon public." },
  { n: 'Mathieu Quidarré',   note: 5, t: "Nassim m'a été recommandé, et je dois dire qu'il est extrêmement compétent dans son domaine. Il est très à l'écoute des problématiques du secteur et propose des suggestions pertinentes. Je le recommande sans hésiter à tout professionnel souhaitant accroître sa visibilité grâce à des stratégies de communication ciblées sur les réseaux sociaux." },
  { n: 'Lamia Amrane',       note: 5, t: "En tant que rédactrice web, j'ai grandement bénéficié du programme LinkedIn Sales Accelerator, conçu et réalisé par l'équipe d'Eagle Eye Digital. J'y ai trouvé des conseils et des astuces à la fois pertinents et extrêmement utiles. Nassim et son équipe ont cerné nos difficultés et trouvé des solutions qui nous permettent de développer notre activité. Un grand merci à toute l'équipe !" },
  { n: 'Alexis Desjardins',  note: 5, t: "Je recommande vivement les services d'Eagle Eye Digital. Leurs conseils avisés et précieux m'ont permis de définir clairement ma stratégie LinkedIn. Je remercie tout particulièrement Julie pour la qualité de nos échanges et Nassim pour son soutien indéfectible." },
  { n: 'Philippe Griffol',   note: 5, t: "Une expérience formidable. La stratégie a été définie après mûre réflexion avec Nassim. Apprendre a été d'autant plus précieux que je suis complètement novice. Résultat : 1200 abonnés LinkedIn en 3 mois, un blog lié à LinkedIn, et un niveau d'autonomie que je n'aurais jamais imaginé atteindre. Nassim, avec sa gentillesse, sa décontraction et sa disponibilité, a été un véritable guide. Mon objectif de partager mes compétences avec un public ciblé a été atteint, et j'en suis extrêmement satisfait. Merci à Nassim et à son équipe." },
  { n: 'Lucrèce Grimaud',    note: 5, t: "L'excellente compréhension des relations clients dont fait preuve Eagle Eye Digital, alliée à une disponibilité sans faille, en fait le partenaire idéal pour notre gestion des réseaux sociaux. L'expertise de Nassim sur LinkedIn est un atout majeur pour l'expérience client. Cette agence est en pleine expansion." },
  { n: 'Marie Ambert',       note: 5, t: "Merci, Nassim, de m'avoir écoutée, d'avoir été si bienveillant, d'avoir donné de précieux conseils et de m'avoir encouragée. Je craignais que tu te comportes comme un simple vendeur, alors j'ai été agréablement surprise. Je sais que si je rencontre des difficultés, je peux toujours compter sur toi." },
  { n: 'Anne Favarcq',       note: 5, t: "J'ai découvert Nassim grâce à BNI et depuis je le suis sur LinkedIn et je participe à ses webinaires. Ses conseils sont toujours pertinents ! Par ailleurs, c'est une personne inspirante qui vous donne envie de l'écouter. Merci Nassim." },
  { n: 'Mélie M.',           note: 5, t: "J'ai récemment suivi une formation LinkedIn proposée par Nassim, et je suis extrêmement satisfaite de l'expérience. L'approche pédagogique est engageante et approfondie ! Merci." },
  { n: 'Catherine Meyss',    note: 5, t: "J'ai été coachée et accompagnée par Nassim et son équipe pour améliorer mon marketing digital sur LinkedIn et cette expérience m'a été ultra bénéfique. Je vous recommande pleinement Eagle Eye Digital !" },
  { n: 'Émilie P.',          note: 5, t: "Un immense merci à Nassim pour sa gentillesse, son efficacité et son excellent réseau. Attentif, dynamique et réactif ! J'ai participé au programme de formation Business Accelerator et j'en suis ravie." },
  { n: 'Lucette Couderc',    note: 5, t: "Nassim donne des conseils précieux et ouvre le champ des possibles pour aider à la publication et à la prospection sur LinkedIn. Et il paraît qu'à la rentrée il y aura du nouveau qui va en intéresser plus d'un ! Merci Nassim !" },
  { n: 'Bernard Quidarré',   note: 4, t: "Je recommande vivement cette personne, qui a une solide expérience en matière de satisfaction client. Son offre est claire : il explique simplement ce qu'il peut vous apporter. Il reste à l'écoute de vos besoins spécifiques et fait de cette flexibilité un atout majeur. L'an dernier, il m'a aidé à élaborer une stratégie de prospection qui a abouti à la signature de cinq contrats. Contactez-le, vous ne le regretterez pas." },
];
---
<Base
  title="Témoignages clients : ils ont confié leur LinkedIn à Eagle Eye Digital"
  description="Consultants, dirigeants de TPE, formateurs : leurs témoignages en vidéo après le LinkedIn Business Accelerator d'Eagle Eye Digital."
>
  <Header />
  <main class="mc-page">

    <!-- HERO -->
    <section class="mc-hero">
      <div class="mc-wrap">
        <span class="mc-eyebrow">Témoignages</span>
        <h1>Ils ont confié leur LinkedIn à <span class="mc-hl">Eagle Eye Digital</span>.</h1>
        <p class="mc-lede">Des indépendants et des dirigeants de TPE, en vidéo et dans leurs mots. Tous passés par le <strong>LinkedIn Business Accelerator</strong>.</p>
        <div class="mc-hero-proof">
          <div><b>450</b> entrepreneurs accompagnés</div>
          <div><b>4,8/5</b> · 47 avis Google</div>
          <div><b>5 pays</b> FR · BE · CH · MA · CA</div>
        </div>
      </div>
    </section>

    <!-- VIDÉOS -->
    <section class="mc-section">
      <div class="mc-wrap">
        <div class="video-temos">
          {paysage.map(t => (
            <figure class="vt-card">
              <button class="video-temo" type="button" data-vimeo-id={t.id} data-vimeo-h={t.h} style={`background-image:url('${thumbUrl(t)}')`} aria-label={`Lire le témoignage de ${t.name}`}>
                <span class="vt-play" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M8 5.5v13l11-6.5z"/></svg></span>
              </button>
              <figcaption>{t.name}</figcaption>
            </figure>
          ))}
        </div>

        <div class="video-temos video-temos-portrait">
          {portrait.map(t => (
            <figure class="vt-card vt-portrait">
              <button class="video-temo" type="button" data-vimeo-id={t.id} data-vimeo-h={t.h} style={`background-image:url('${thumbUrl(t)}')`} aria-label={`Lire le témoignage de ${t.name}`}>
                <span class="vt-play" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M8 5.5v13l11-6.5z"/></svg></span>
              </button>
              <figcaption>{t.name}</figcaption>
            </figure>
          ))}
        </div>
      </div>
    </section>

    <!-- AVIS GOOGLE -->
    <section class="mc-section mc-avis">
      <div class="mc-wrap">
        <div class="mc-avis-head">
          <span class="mc-eyebrow">Ils en parlent</span>
          <h2>Nos avis <span class="mc-hl">Google</span></h2>
          <div class="av-score">
            <span class="av-score-g" aria-hidden="true">
              <svg viewBox="0 0 24 24"><path fill="#4285F4" d="M23.52 12.27c0-.82-.07-1.6-.2-2.36H12v4.47h6.47a5.53 5.53 0 0 1-2.4 3.63v3h3.88c2.27-2.09 3.57-5.17 3.57-8.74z"/><path fill="#34A853" d="M12 24c3.24 0 5.96-1.08 7.95-2.9l-3.88-3c-1.08.72-2.45 1.15-4.07 1.15-3.13 0-5.78-2.11-6.73-4.96H1.26v3.1A12 12 0 0 0 12 24z"/><path fill="#FBBC05" d="M5.27 14.29a7.2 7.2 0 0 1 0-4.58v-3.1H1.26a12 12 0 0 0 0 10.78l4.01-3.1z"/><path fill="#EA4335" d="M12 4.75c1.77 0 3.35.61 4.6 1.8l3.44-3.44A11.97 11.97 0 0 0 12 0 12 12 0 0 0 1.26 6.61l4.01 3.1C6.22 6.86 8.87 4.75 12 4.75z"/></svg>
            </span>
            <span class="av-score-num">4,8</span>
            <span class="av-score-stars" aria-hidden="true">★★★★★</span>
            <span class="av-score-count">sur&nbsp;47 avis Google</span>
          </div>
        </div>

        <div class="av-grid">
          {avis.map(a => (
            <figure class="av-card">
              <span class="av-stars" aria-label={`Note : ${a.note} sur 5`}>
                <span class="av-full">{'★'.repeat(a.note)}</span><span class="av-empty">{'★'.repeat(5 - a.note)}</span>
              </span>
              <blockquote>{a.t}</blockquote>
              <figcaption>{a.n}</figcaption>
            </figure>
          ))}
        </div>

        <div class="mc-center">
          <a class="mc-cta mc-cta-ghost" href="https://share.google/cp6QTGVTk94meNpk0" target="_blank" rel="noopener">Voir tous les avis sur Google →</a>
        </div>
      </div>
    </section>

    <!-- LBA : LE PROGRAMME QU'ILS ONT SUIVI -->
    <section class="mc-section">
      <div class="mc-wrap mc-narrow">
        <span class="mc-eyebrow">Le programme qu'ils ont suivi</span>
        <h2>Le <span class="mc-hl">LinkedIn Business Accelerator</span></h2>
        <p class="mc-text">Nos témoins n'ont pas « fait du LinkedIn » tout seuls dans leur coin. Ils ont installé un système avec notre équipe : des actions mises en place pour eux dès le premier mois, puis un accompagnement qui tient sur la durée. Le socle, c'est la méthode 3C+2.</p>
      </div>
    </section>

    <!-- MÉTHODE 3C+2 -->
    <section class="mc-section">
      <div class="mc-wrap">
        <h3 class="mc-h3 mc-center">La méthode 3C+2 : cinq piliers, dans cet ordre</h3>
        <div class="mc-piliers">
          {piliers.map(p => (
            <div class="mc-pilier">
              <span class="mc-badge">{p.c}</span>
              <h4>{p.t}</h4>
              <p>{p.d}</p>
            </div>
          ))}
        </div>
        <p class="mc-text mc-center mc-muted">Retirez une pièce, et le système ne fonctionne plus. Mettez les cinq en place, et les résultats s'enchaînent.</p>
      </div>
    </section>

    <!-- CE QUE CONTIENT LE PROGRAMME -->
    <section class="mc-section">
      <div class="mc-wrap">
        <h3 class="mc-h3 mc-center">Des résultats vite, un système qui dure</h3>
        <div class="mc-cards">
          <div class="mc-card">
            <span class="mc-tag">Les 30 premiers jours</span>
            <h4>L'équipe met en place les actions</h4>
            <ul class="mc-list">
              <li>Diagnostic &amp; roadmap personnalisés (3C+2)</li>
              <li>Revue stratégique du profil et des posts</li>
              <li>Création ou ajustement de l'offre</li>
              <li>Activation du réseau sur des connexions qualifiées</li>
            </ul>
          </div>
          <div class="mc-card">
            <span class="mc-tag">Les mois suivants</span>
            <h4>Vous sécurisez la durée</h4>
            <ul class="mc-list">
              <li>Coaching collectif 3 fois par semaine</li>
              <li>E-learning structuré sur la méthode 3C+2</li>
              <li>Communauté privée d'entraide</li>
              <li>Accès illimité, même après la phase active</li>
            </ul>
          </div>
        </div>
      </div>
    </section>

    <!-- GARANTIE -->
    <section class="mc-section">
      <div class="mc-wrap mc-narrow">
        <div class="mc-garantie">
          <div class="mc-badge-round">100 %<br>GARANTIE</div>
          <div>
            <h4>Satisfait ou remboursé</h4>
            <p>Si le programme ne vous correspond pas, vous demandez le remboursement et on rembourse. Finançable, organisme de formation certifié Qualiopi. Depuis que le LinkedIn Business Accelerator existe, cette garantie n'a jamais été activée.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- CTA LBA -->
    <section class="mc-section">
      <div class="mc-wrap mc-narrow mc-center">
        <a class="mc-cta" href="/offres/accompagnement-prospection/">Découvrir le LinkedIn Business Accelerator →</a>
        <p class="mc-note">Une dizaine de places par mois. Sans engagement.</p>
      </div>
    </section>

    <!-- FINAL : DIAGNOSTIC -->
    <section class="mc-section mc-final">
      <div class="mc-wrap mc-narrow mc-center">
        <h3 class="mc-h3">Et vous, où en êtes-vous ?</h3>
        <p class="mc-text mc-muted">Commencez comme eux : par le diagnostic gratuit de votre présence LinkedIn.</p>
        <a class="mc-cta mc-cta-ghost" href="/#scanner">Faire mon diagnostic gratuit</a>
      </div>
    </section>

  </main>

  <style>
    /* ===== Palette locale : funnel masterclass.eagleeye.digital ===== */
    .mc-page{
      --navy:#0B1B33;
      --navy-2:#122744;
      --navy-3:#0E2142;
      --blue:#1B6EF3;
      --blue-dark:#0F52C4;
      --yellow:#FFD400;
      --yellow-dark:#E5BE00;
      --ink:#EAF1FF;
      --muted:#B9C8DE;
      --muted-2:#8A99AE;
      --line:rgba(255,255,255,.1);
      background:var(--navy);
      color:var(--ink);
      padding-bottom:30px;
    }
    .mc-wrap{max-width:1040px;margin:0 auto;padding:0 24px}
    .mc-narrow{max-width:760px}
    .mc-center{text-align:center}
    .mc-muted{color:var(--muted)}
    .mc-section{padding:48px 0}
    .mc-page strong{color:#fff}

    /* surligné jaune incliné, repris tel quel du funnel */
    /* Surligné plein : sur fond bleu nuit, le texte doit reposer entièrement
       sur le jaune (sinon la partie des lettres hors de la barre jaune serait
       bleu nuit sur bleu nuit, donc invisible). Bloc jaune incliné derrière
       tout le mot, texte bleu nuit lisible par-dessus. */
    .mc-hl{position:relative;display:inline-block;color:var(--navy);z-index:0;padding:.08em 10px;line-height:1.1}
    .mc-hl::before{
      content:"";position:absolute;inset:0;
      background:var(--yellow);transform:skewX(-6deg);z-index:-1;border-radius:3px;
    }

    .mc-eyebrow{
      display:inline-block;font-size:.74rem;font-weight:700;letter-spacing:.16em;
      text-transform:uppercase;color:var(--yellow);margin-bottom:14px;
    }

    /* ===== Hero ===== */
    .mc-hero{
      background:linear-gradient(170deg,var(--navy-2) 0%,var(--navy) 70%);
      border-bottom:1px solid var(--line);
      padding:64px 0 54px;
    }
    .mc-hero h1{
      font-size:clamp(1.9rem,4vw,2.9rem);font-weight:800;color:#fff;
      line-height:1.14;margin:0 0 20px;max-width:22ch;letter-spacing:-.01em;
    }
    .mc-lede{color:var(--muted);font-size:1.1rem;max-width:52ch;margin:0;line-height:1.6}
    .mc-hero-proof{
      display:flex;gap:30px;flex-wrap:wrap;margin-top:34px;
      border-top:1px dashed var(--line);padding-top:24px;
    }
    .mc-hero-proof div{font-size:.86rem;color:var(--muted-2);font-weight:600}
    .mc-hero-proof b{display:block;color:#fff;font-size:1.7rem;line-height:1;font-weight:800;margin-bottom:4px}

    /* ===== Titres ===== */
    .mc-page h2{font-size:clamp(1.6rem,3.2vw,2.3rem);font-weight:800;color:#fff;line-height:1.16;margin:0 0 16px}
    .mc-h3{font-size:clamp(1.3rem,2.4vw,1.7rem);font-weight:800;color:#fff;line-height:1.2;margin:0 0 28px}
    .mc-text{color:var(--muted);font-size:1.04rem;line-height:1.68;margin:0 auto;max-width:62ch}
    .mc-center.mc-text,.mc-text.mc-center{margin-top:26px}

    /* ===== Cartes vidéo (surcharge l'habillage global, couleurs funnel) ===== */
    .mc-page .video-temo{background-color:var(--navy-2);box-shadow:0 18px 44px -24px rgba(0,0,0,.7)}
    .mc-page .vt-play{border:2px solid var(--yellow);background:rgba(27,110,243,.45)}
    .mc-page .video-temo:hover .vt-play{background:rgba(27,110,243,.7)}
    .mc-page .vt-play svg{fill:var(--yellow)}
    .mc-page .vt-card figcaption{color:var(--muted);font-weight:600}

    /* ===== Piliers 3C+2 ===== */
    .mc-piliers{display:grid;grid-template-columns:repeat(5,1fr);gap:16px}
    .mc-pilier{
      background:var(--navy-2);border:1px solid var(--line);border-top:3px solid var(--yellow);
      border-radius:14px;padding:22px 18px;display:flex;flex-direction:column;gap:8px;
    }
    .mc-badge{
      width:40px;height:40px;border-radius:10px;flex:none;
      background:var(--yellow);color:var(--navy);font-weight:800;font-size:1.3rem;
      display:flex;align-items:center;justify-content:center;
    }
    .mc-pilier h4{font-size:1.05rem;font-weight:700;color:#fff;margin:4px 0 0}
    .mc-pilier p{font-size:.86rem;color:var(--muted);margin:0;line-height:1.55}

    /* ===== Cartes contenu ===== */
    .mc-cards{display:grid;grid-template-columns:1fr 1fr;gap:22px;max-width:860px;margin:0 auto}
    .mc-card{
      background:var(--navy-2);border:1px solid var(--line);border-radius:18px;padding:30px 28px;
    }
    .mc-tag{
      display:inline-block;font-size:.7rem;font-weight:700;letter-spacing:.12em;
      text-transform:uppercase;color:#fff;margin-bottom:10px;
    }
    .mc-card h4{font-size:1.2rem;font-weight:800;color:#fff;margin:0 0 16px}
    .mc-list{list-style:none;margin:0;padding:0;display:grid;gap:11px}
    .mc-list li{position:relative;padding-left:28px;color:var(--muted);font-size:.94rem;line-height:1.5}
    .mc-list li::before{content:"✓";position:absolute;left:0;top:0;color:var(--yellow);font-weight:800}

    /* ===== Garantie ===== */
    .mc-garantie{
      display:flex;gap:24px;align-items:center;
      background:var(--navy-2);border-left:4px solid var(--yellow);border-radius:0 14px 14px 0;
      padding:28px 30px;
    }
    .mc-badge-round{
      flex:none;width:92px;height:92px;border-radius:50%;
      background:var(--yellow);color:var(--navy);font-weight:800;font-size:.9rem;line-height:1.15;
      display:flex;align-items:center;justify-content:center;text-align:center;
    }
    .mc-garantie h4{font-size:1.2rem;font-weight:800;color:#fff;margin:0 0 8px}
    .mc-garantie p{color:var(--muted);font-size:.96rem;line-height:1.6;margin:0}

    /* ===== CTA ===== */
    .mc-cta{
      display:inline-block;text-decoration:none;
      background:linear-gradient(180deg,var(--blue) 0%,var(--blue-dark) 100%);
      color:#fff;font-weight:800;font-size:1.06rem;letter-spacing:.4px;
      padding:18px 38px;border-radius:12px;
      box-shadow:0 6px 0 #0A3F96, 0 12px 24px rgba(15,82,196,.35);
      transition:transform .12s ease,box-shadow .12s ease;
    }
    .mc-cta:hover{transform:translateY(3px);box-shadow:0 3px 0 #0A3F96, 0 8px 18px rgba(15,82,196,.35)}
    .mc-cta:active{transform:translateY(6px);box-shadow:0 0 0 #0A3F96}
    .mc-cta:focus-visible{outline:3px solid var(--yellow);outline-offset:3px}
    .mc-note{margin:16px 0 0;color:var(--muted-2);font-size:.86rem}
    .mc-cta-ghost{
      background:transparent;color:var(--yellow);
      border:2px solid var(--yellow);box-shadow:none;
    }
    .mc-cta-ghost:hover{transform:translateY(-2px);box-shadow:none;background:rgba(255,212,0,.08)}
    .mc-cta-ghost:active{transform:none;box-shadow:none}

    /* ===== Final ===== */
    .mc-final{border-top:1px solid var(--line);margin-top:10px}
    .mc-final .mc-text{margin-bottom:26px}

    /* ===== Avis Google ===== */
    .mc-avis-head{text-align:center;margin-bottom:34px}
    .mc-avis-head h2{margin-bottom:18px}
    .av-score{
      display:inline-flex;align-items:center;gap:10px;flex-wrap:wrap;justify-content:center;
      background:var(--navy-2);border:1px solid var(--line);border-radius:999px;padding:10px 22px;
    }
    .av-score-g{display:inline-flex;width:22px;height:22px}
    .av-score-g svg{width:100%;height:100%}
    .av-score-num{font-size:1.4rem;font-weight:800;color:#fff;line-height:1}
    .av-score-stars{color:var(--yellow);letter-spacing:1px;font-size:1.05rem}
    .av-score-count{color:var(--muted);font-size:.9rem;font-weight:600}

    /* mur « masonry » : colonnes CSS, cartes de hauteur variable qui s'imbriquent */
    .av-grid{column-count:3;column-gap:20px}
    .av-card{
      break-inside:avoid;width:100%;margin:0 0 20px;display:inline-block;
      background:var(--navy-2);border:1px solid var(--line);border-radius:16px;padding:24px 24px 20px;
    }
    .av-stars{display:block;font-size:1.02rem;letter-spacing:1px;margin-bottom:12px}
    .av-stars .av-full{color:var(--yellow)}
    .av-stars .av-empty{color:rgba(255,255,255,.22)}
    .av-card blockquote{margin:0 0 16px;color:var(--ink);font-size:.95rem;line-height:1.6}
    .av-card figcaption{color:#fff;font-weight:700;font-size:.92rem}

    /* ===== Responsive ===== */
    @media (max-width:980px){
      .av-grid{column-count:2}
    }
    @media (max-width:880px){
      .mc-piliers{grid-template-columns:repeat(2,1fr)}
      .mc-cards{grid-template-columns:1fr}
    }
    @media (max-width:640px){
      .av-grid{column-count:1}
    }
    @media (max-width:600px){
      .mc-section{padding:38px 0}
      .mc-hero{padding:48px 0 40px}
      .mc-hero-proof{gap:20px}
      .mc-piliers{grid-template-columns:1fr}
      .mc-garantie{flex-direction:column;text-align:center;align-items:center;border-left:0;border-top:4px solid var(--yellow);border-radius:0 0 14px 14px}
      .mc-cta{display:block}
    }
  </style>
</Base>
