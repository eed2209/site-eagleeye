---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';

/* Les vidéos sont servies par nginx depuis /var/www/media/temoignages/ sur le
   VPS (hors du repo et du rsync de déploiement — trop lourdes pour git).
   Source d'origine : témoignages filmés à l'Indépendance Day (page ID3). */
const videos = ['01', '02', '04', '05', '06', '09', '10', '11', '12', '14', '15', '16'];
---
<Base
  title="Témoignages clients : ils ont confié leur LinkedIn à Eagle Eye Digital"
  description="Consultants, dirigeants de TPE, formateurs : leurs témoignages en vidéo après avoir confié leur prospection LinkedIn à Eagle Eye Digital."
>
  <Header />
  <main class="page">
    <span class="eyebrow">Témoignages</span>
    <h1>Ils ont confié leur LinkedIn à Eagle Eye Digital.</h1>
    <p class="lede">Des indépendants et des dirigeants de TPE, en vidéo et dans leurs mots.</p>

    <section>
      <div class="video-temos video-temos-grid">
        {videos.map((id, i) => (
          <button class="video-temo" type="button" data-video={`/media/temoignages/temoignage-${id}.mp4`} style={`background-image:url('/media/temoignages/temoignage-${id}.webp')`} aria-label={`Lire le témoignage vidéo ${i + 1}`}>
            <span class="vt-play" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"><path d="M8 5.5v13l11-6.5z"/></svg></span>
          </button>
        ))}
      </div>
    </section>

    <section>
      <h2>Et vous, où en êtes-vous ?</h2>
      <p>Commencez comme eux : par le <a href="/diagnostic-linkedin/">diagnostic gratuit</a>.</p>
      <a class="btn" href="/#scanner">Faire mon diagnostic gratuit</a>
    </section>
  </main>
</Base>
