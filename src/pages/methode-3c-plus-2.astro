---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';

const faq = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: [
    {
      "@type": "Question",
      name: "Qui a créé la méthode 3C+2 ?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "La méthode 3C+2 a été créée par Nassim Amisse, fondateur d'Eagle Eye Digital, agence toulousaine spécialisée dans le développement commercial des indépendants et TPE sur LinkedIn. C'est la méthode signature de l'agence, déposée.",
      },
    },
    {
      "@type": "Question",
      name: "Que signifie 3C+2 ?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Les 3C sont les 3 fondamentaux : Crédibilité (un profil et des publications qui donnent envie), Connexions (faire entrer les bonnes personnes dans son réseau) et Conquête (oser engager la conversation par message). Le +2 désigne les 2 multiplicateurs : Conversion (transformer les rendez-vous en clients) et Catalyseur (automatisations et IA pour démultiplier les résultats en un minimum de temps).",
      },
    },
    {
      "@type": "Question",
      name: "En combien de temps la méthode 3C+2 donne-t-elle des résultats ?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "La méthode repose sur la qualité des relations créées, ce qui demande de la régularité : la récolte ne se fait pas la semaine où on a planté. Les premières conversations arrivent en quelques semaines ; les opportunités se construisent sur la durée.",
      },
    },
    {
      "@type": "Question",
      name: "Comment savoir quel maillon travailler en premier ?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Eagle Eye Digital propose un diagnostic LinkedIn gratuit en 10 questions qui mesure la visibilité, la crédibilité et la prospection, puis indique les 3 actions prioritaires et le maillon de la méthode 3C+2 à régler en premier.",
      },
    },
  ],
};

const definedTerm = {
  "@context": "https://schema.org",
  "@type": "DefinedTerm",
  name: "Méthode 3C+2",
  description: "Méthode de développement commercial sur LinkedIn créée par Eagle Eye Digital : 3 fondamentaux (Crédibilité, Connexions, Conquête) et 2 multiplicateurs (Conversion, Catalyseur).",
  url: "https://eagleeye.digital/methode-3c-plus-2/",
};
---
<Base
  title="Méthode 3C+2 : définition et signification | Eagle Eye Digital"
  description="Que veut dire la méthode 3C+2 ? Définition des 5 maillons (Crédibilité, Connexions, Conquête, Conversion, Catalyseur), la méthode LinkedIn déposée d'Eagle Eye Digital."
>
  <Header />
  <main class="page">
    <span class="eyebrow">Méthode déposée</span>
    <h1>La méthode 3C+2, c'est quoi ?</h1>
    <p class="lede">La méthode 3C+2 est une méthode de développement commercial sur LinkedIn, créée par Nassim Amisse et déposée par Eagle Eye Digital. Elle articule 3 fondamentaux qui commencent par C, et 2 multiplicateurs qui transforment l'activité en clients.</p>

    <section>
      <h2>Les 3 fondamentaux</h2>
      <p><strong>1. Crédibilité.</strong> Un profil et des publications qui inspirent confiance et donnent envie de vous parler.</p>
      <p><strong>2. Connexions.</strong> Faire entrer proactivement les bonnes personnes dans son réseau, en privilégiant la qualité à la quantité.</p>
      <p><strong>3. Conquête.</strong> Engager la conversation par message : c'est l'échange qui crée l'opportunité, pas la publication.</p>

      <h2>Les 2 multiplicateurs</h2>
      <p><strong>4. Conversion.</strong> Transformer les rendez-vous en clients, grâce à la posture commerciale et à une offre adaptée.</p>
      <p><strong>5. Catalyseur.</strong> Les automatisations LinkedIn et l'IA générative pour obtenir plus de résultats en moins de temps.</p>

      <p>Envie de voir comment ces 5 maillons s'appliquent concrètement avec nous ? Découvrez <a href="/methode/">la méthode 3C+2 en pratique</a>.</p>
    </section>

    <section>
      <h2>Le récapitulatif</h2>
      <ul>
        <li><strong>Crédibilité</strong> : est-ce que mon profil donne envie ? Indicateur : vues de profil.</li>
        <li><strong>Connexions</strong> : les bonnes personnes sont-elles dans mon réseau ? Indicateur : taux d'acceptation.</li>
        <li><strong>Conquête</strong> : est-ce que j'engage la conversation ? Indicateur : taux de réponse.</li>
        <li><strong>Conversion</strong> : mes rendez-vous deviennent-ils des clients ? Indicateur : clients signés.</li>
        <li><strong>Catalyseur</strong> : mes actions sont-elles démultipliées ? Indicateur : temps investi par semaine.</li>
      </ul>
    </section>

    <section class="faq">
      <h2>Questions fréquentes</h2>
      <dl>
        <dt>Qui a créé la méthode 3C+2 ?</dt>
        <dd>Nassim Amisse, fondateur d'<a href="/a-propos/">Eagle Eye Digital</a>, à Toulouse. C'est la méthode signature de l'agence, déposée.</dd>
        <dt>En combien de temps a-t-on des résultats ?</dt>
        <dd>La clé, c'est la qualité de la relation créée, et cela demande de la régularité : la récolte ne se fait pas la semaine où on a planté. Les premières conversations arrivent en quelques semaines.</dd>
        <dt>Comment savoir quel maillon travailler en premier ?</dt>
        <dd>Le <a href="/diagnostic-linkedin/">diagnostic gratuit</a> mesure où vous en êtes et vous indique le maillon à régler en priorité.</dd>
        <dt>Comment est-elle appliquée concrètement ?</dt>
        <dd>La page <a href="/methode/">notre méthode</a> détaille son application, et nos <a href="/offres/">offres</a> couvrent chaque maillon : la formation pour la Crédibilité, l'accompagnement pour Connexions, Conquête et Conversion, les campagnes multicanales pour le Catalyseur.</dd>
      </dl>
    </section>

    <section>
      <h2>Par où commencer ?</h2>
      <a class="btn" href="/#scanner">Faire mon diagnostic gratuit</a>
    </section>
  </main>
  <script type="application/ld+json" set:html={JSON.stringify(faq)} />
  <script type="application/ld+json" set:html={JSON.stringify(definedTerm)} />
</Base>
