---
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import { getCollection } from 'astro:content';

const now = Date.now();
const posts = (await getCollection('blog', ({ data }) => data.draft !== true && data.date.valueOf() <= now)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
---
<Base
  title="Blog : prospection LinkedIn pour indépendants et TPE"
  description="Conseils concrets pour trouver des clients sur LinkedIn quand on est indépendant ou TPE : profil, messages de prospection, contenu, webinaires."
>
  <Header />
  <main class="page">
    <span class="eyebrow">Blog</span>
    <h1>Trouver des clients sur LinkedIn, article après article.</h1>
    <p class="lede">Des conseils applicables tout de suite, tirés de 6 ans d'accompagnement d'indépendants et de TPE.</p>

    <section>
      <ul class="post-grid">
        {posts.map((post) => (
          <li class="post-card">
            <a href={`/blog/${post.slug}/`}>
              <span class="post-card-date">{post.data.date.toLocaleDateString('fr-FR', { year: 'numeric', month: 'long', day: 'numeric' })}</span>
              <h2 class="post-card-title">{post.data.title.replace(/\s*\/\/\s*/g, ' ')}</h2>
              <p class="post-card-desc">{post.data.description}</p>
              <span class="post-card-more">Lire l'article →</span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  </main>
</Base>
