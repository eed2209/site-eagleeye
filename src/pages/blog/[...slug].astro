---
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => data.draft !== true);
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await post.render();

// Titre du H1 : l'autrice choisit où couper en insérant « // » (ou un vrai
// retour à la ligne) dans le titre, là où elle veut un passage à la ligne.
// À défaut, l'ancienne option titleBreak coupe après le premier " : ".
// Dans tous les cas, le titre SEO (<title> et données structurées) reste
// sur une seule ligne.
const rawTitle = post.data.title;
const manualLines = rawTitle.split(/\s*\/\/\s*|\r?\n/).map((s) => s.trim()).filter(Boolean);
let titleLines;
if (manualLines.length > 1) {
  titleLines = manualLines;
} else if (post.data.titleBreak) {
  const parts = rawTitle.split(/ : (.+)/s);
  titleLines = parts[1] ? [`${parts[0]} :`, parts[1]] : [rawTitle];
} else {
  titleLines = [rawTitle];
}
const titleClean = titleLines.join(' ');
const dateFr = post.data.date.toLocaleDateString('fr-FR', { year: 'numeric', month: 'long', day: 'numeric' });

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: titleClean,
  description: post.data.description,
  datePublished: post.data.date.toISOString(),
  author: { "@type": "Organization", name: "Eagle Eye Digital", url: "https://eagleeye.digital" },
  publisher: { "@type": "Organization", name: "Eagle Eye Digital" },
};
---
<Base title={titleClean} description={post.data.description}>
  <Header />
  <main class="page prose">
    <span class="eyebrow">Blog</span>
    <h1>{titleLines.map((line, i) => (<>{i > 0 && <br />}{line}</>))}</h1>
    <p class="post-meta">Publié le {dateFr} · Eagle Eye Digital</p>
    <Content />
    <section>
      <h2>Passez à l'action</h2>
      <p>Mesurez précisément où vous en êtes avec le diagnostic LinkedIn complet : votre score sur les 5 piliers et vos 3 actions prioritaires.</p>
      <a class="btn" href="/scan/">Faire mon diagnostic gratuit</a>
    </section>
  </main>
  <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
</Base>
